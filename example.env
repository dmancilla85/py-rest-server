# server settings
PORT=5000

# debug or production
MODE=DEBUG

# db settings
MONGODB_CONN=<MONGO CONNEXION>
MONGODB_DB=<DATABASE NAME>

# logging configuration [NOTSET, DEBUG, INFO, WARNING, ERROR, CRITICAL]
LOG_LEVEL=INFO
LOG_PATH=</logs>
# days to save old backup
LOG_BACKUP_COUNT=10

# jwt settings
JWT_ISSUER=<ISSUER>
JWT_AUDIENCE=<AUDIENCE>
JWT_LIFETIME_SECONDS=<SECONDS TO EXPIRE>
JWT_SECRET_KEY=<A LONG RANDOM SECRET KEY>

# rate limiting settings
# enable/disable rate limiting [true/false]
RATE_LIMIT_ENABLED=true
# default limits for /api/v1/* endpoints (per IP); ';' separates multiple limits
RATE_LIMIT_DEFAULT=60 per minute; 5 per second
# stricter limit for /auth/login (per IP)
RATE_LIMIT_LOGIN=5 per minute
# storage backend; use "redis://localhost:6379" for multi-worker deployments
RATE_LIMIT_STORAGE_URI=memory://